{
  "name": "Casino Matrix",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "postStartCommand": "nohup python -m uvicorn provider.main:app --host 0.0.0.0 --port 8090 > /tmp/casino-matrix.log 2>&1 &",
  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": { "label": "Casino Matrix", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
